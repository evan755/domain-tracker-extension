{
  "manifest_version": 3,
  "name": "Domain Tracker Extension",
  "version": "1.0.0",
  "description": "Domain Tracker Extension",
  "permissions": [
    "webRequest",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "index.html"
  },
  "options_page": "options.html"
}